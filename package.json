{
    "name": "@ostro/pagination",
    "version": "2.0.0-alpha.2",
    "description": "Pagination module for OstroJS",
    "main": "build/lengthAwarePaginator.js",
    "types": "./build/types/lengthAwarePaginator.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/types/lengthAwarePaginator.d.ts",
            "default": "./build/lengthAwarePaginator.js"
        },
        "./*": {
            "types": "./build/types/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.2",
        "@ostro/support": "^2.0.0-alpha.2"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "pagination",
        "paginator"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/pagination.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/pagination/issues"
    },
    "homepage": "https://github.com/ostrojs/pagination#readme",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.8.0",
        "@types/jest": "^30.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "@ostro/builder": "^2.0.0-alpha.1"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
